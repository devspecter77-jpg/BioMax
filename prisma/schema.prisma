generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ========================
// FILIALLAR
// ========================
model Filial {
  id         String   @id @default(cuid())
  nomi       String
  manzil     String?
  telefon    String?
  faol       Boolean  @default(true)
  // Xaritadagi joylashuvi. Ega filialni xaritada belgilaydi yoki
  // filial oldida turib "shu yerdaman" tugmasi bilan oladi.
  lokatsiyaLat Float?
  lokatsiyaLng Float?
  yaratilgan DateTime @default(now())

  xodimlar   Foydalanuvchi[]
  kategoriyalar Kategoriya[]
  omborlar      Ombor[]
  tovarlar      Tovar[]
  mijozlar      Mijoz[]
  taminotchilar Taminotchi[]
  sotuvlar      Sotuv[]
  xarajatlar    Xarajat[]
  buyurtmalar   Buyurtma[]
  taminotchiSorovlari  TaminotchiSorov[]
  xodimTolovlari       XodimTolov[]
  taminotchiQarzlari   TaminotchiQarz[]
  dokonQarzlari        DokonQarz[]
  yuborilganOtkazmalar Otkazma[] @relation("OtkazmaManba")
  qabulOtkazmalar      Otkazma[] @relation("OtkazmaQabul")

  @@map("filiallar")
}

// ========================
// FOYDALANUVCHILAR
// ========================
model Foydalanuvchi {
  id           String   @id @default(cuid())
  ism          String
  login        String   @unique
  parolHash    String
  rol          Rol      @default(KASSIR)
  faol         Boolean  @default(true)
  telefon      String?
  // Belgilangan oylik maosh (so'mda). To'lovlar `XodimTolov` da alohida
  // yoziladi — bu faqat "kelishilgan summa" ko'rsatkichi.
  oylikMaosh   Decimal? @db.Decimal(12, 2)
  filialId     String?
  yaratilgan   DateTime @default(now())
  yangilangan  DateTime @updatedAt

  // Xodim saytga kirganda (brauzer ruxsat bergan bo'lsa) sokin ravishda
  // yoziladi — Ega Filiallar sahifasida "hozir shu yerda" deb ko'rishi uchun.
  lokatsiyaLat        Float?
  lokatsiyaLng        Float?
  lokatsiyaYangilangan DateTime?

  // Ega o'z mahsulotlar katalogini boshqa Admin hisobiga ulashishi —
  // ulashilganEgaId shu adminning qaysi Eganing katalogini ko'rishini
  // belgilaydi (filialId kabi, faqat filialsiz Ega darajasida).
  ulashilganEgaId String?
  tovarTahrirlashMumkin Boolean @default(true)
  tovarOchirishMumkin   Boolean @default(true)

  filial       Filial?  @relation(fields: [filialId], references: [id])
  ulashganEga  Foydalanuvchi?  @relation("EgaUlashish", fields: [ulashilganEgaId], references: [id])
  ulashilganAdminlar Foydalanuvchi[] @relation("EgaUlashish")
  ozTovarlari  Tovar[]  @relation("TovarEgasi")
  ozMijozlari  Mijoz[]  @relation("MijozEgasi")
  ozKategoriyalari Kategoriya[] @relation("KategoriyaEgasi")
  ozOmborlari      Ombor[]      @relation("OmborEgasi")
  ozTaminotchilari Taminotchi[] @relation("TaminotchiEgasi")
  ozSotuvlari  Sotuv[]  @relation("SotuvEgasi")
  ozXarajatlari Xarajat[] @relation("XarajatEgasi")
  sotuvlar     Sotuv[]
  omborlar     OmborHarakati[]
  xarajatlar   Xarajat[]
  xaridlar     Xarid[]
  nasiyaTolovlar NasiyaTolov[]
  xaridTolovlar  XaridTolov[] @relation("xaridTolovlar")
  qaytarishlar Qaytarish[]
  buyurtmalar  Buyurtma[]
  ruxsatlar    Ruxsat[]
  ruxsatJurnali        RuxsatJurnali[]    @relation("RuxsatJurnaliXodim")
  ozgartirganRuxsatlar RuxsatJurnali[]    @relation("RuxsatJurnaliAdmin")
  yashirilganMaydonlar MaydonYashirish[]
  sodiqlikHarakatlari  SodiqlikHarakati[]
  otkazmalar           Otkazma[]
  ozBuyurtmalari       Buyurtma[] @relation("BuyurtmaEgasi")
  kunlikHisobotlar     KunlikHisobotLog[] @relation("KunlikHisobotlar")
  taminotchiSorovlari  TaminotchiSorov[]  @relation("TaminotchiSorovlari")
  tolovlari            XodimTolov[]       @relation("XodimTolovlari")
  taminotchiQarzlari   TaminotchiQarz[]   @relation("TaminotchiQarzYaratgan")
  dokonQarzlari        DokonQarz[]        @relation("DokonQarzYaratgan")
  uchunXarajatlar      Xarajat[]          @relation("XarajatXodimi")
  yaratganTolovlari    XodimTolov[]       @relation("XodimTolovYaratgan")
  ozTaminotchiSorovlari TaminotchiSorov[] @relation("TaminotchiSorovEgasi")
  onlaynRezervlar       OnlaynRezerv[]     @relation("OnlaynRezervlar")
  mulklari              XodimMulki[]       @relation("XodimMulklari")
  yaratganMulklari      XodimMulki[]       @relation("XodimMulkYaratgan")
  yakunlaganMulklari    XodimMulki[]       @relation("XodimMulkYakunlagan")
  dostavchikProfili     DostavchikProfil?  @relation("DostavchikProfili")
  yetkazishlari         OnlaynYetkazish[]  @relation("DostavchikYetkazishlari")
  tayinlaganYetkazishlar OnlaynYetkazish[] @relation("YetkazishTayinlagan")
  olganNamunalari       NamunaBerish[]     @relation("DostavchikNamunalari")
  berganNamunalari      NamunaBerish[]     @relation("NamunaBergan")
  qabulQilganNamunalar  NamunaTarkibi[]    @relation("NamunaQabulQilgan")

  @@index([filialId])
  @@index([ulashilganEgaId])
  @@map("foydalanuvchilar")
}

enum Rol {
  ADMIN
  KASSIR
  OMBORCHI
  SOTUVCHI
  // Onlayn buyurtmalarni yetkazadi va mijozlarga namuna tovar ko'rsatadi.
  // Standart holatda faqat "Onlayn buyurtmalar" ochiq (ruxsat-katalogi.ts).
  DOSTAVCHIK
}

// ========================
// RUXSATLAR
// ========================
model Ruxsat {
  id              String   @id @default(cuid())
  foydalanuvchiId String
  bolim           String
  korinadi        Boolean
  yangilangan     DateTime @updatedAt

  foydalanuvchi   Foydalanuvchi @relation(fields: [foydalanuvchiId], references: [id], onDelete: Cascade)

  @@unique([foydalanuvchiId, bolim])
  @@map("ruxsatlar")
}

// Ruxsat o'zgarishlari jurnali — kim, kimga, qaysi ruxsatni, qachon.
// Xodim "menga kim yopib qo'ydi?" deb so'rasa yoki noto'g'ri ruxsat berilsa,
// iz shu yerda. Hisob o'chirilsa ham jurnal saqlanadi (ism nusxasi bilan).
model RuxsatJurnali {
  id              String   @id @default(cuid())
  // Ruxsati o'zgargan xodim
  foydalanuvchiId String?
  foydalanuvchiIsm String
  // O'zgartirgan administrator
  ozgartiruvchiId String?
  ozgartiruvchiIsm String
  kalit           String
  // Samarali qiymat: o'zgarishdan oldin va keyin (true — ochiq)
  eski            Boolean
  yangi           Boolean
  // QOLDA — qo'lda; NUSXA — boshqa xodimdan nusxa; STANDART — rol standartiga qaytarish
  sabab           String   @default("QOLDA")
  sana            DateTime @default(now())

  foydalanuvchi   Foydalanuvchi? @relation("RuxsatJurnaliXodim", fields: [foydalanuvchiId], references: [id], onDelete: SetNull)
  ozgartiruvchi   Foydalanuvchi? @relation("RuxsatJurnaliAdmin", fields: [ozgartiruvchiId], references: [id], onDelete: SetNull)

  @@index([foydalanuvchiId, sana])
  @@index([sana])
  @@map("ruxsat_jurnali")
}

// ========================
// KATEGORIYALAR
// ========================
model Kategoriya {
  id          String   @id @default(cuid())
  nomi        String
  tavsif      String?
  // Qaysi omborga tegishli. Ixtiyoriy: eski kategoriyalar omborsiz
  // qoladi va "Boshqa" guruhida ko'rinadi.
  omborId     String?
  filialId    String?
  egaId       String?
  yaratilgan  DateTime @default(now())

  ombor       Ombor?   @relation(fields: [omborId], references: [id], onDelete: SetNull)
  filial      Filial?  @relation(fields: [filialId], references: [id])
  ega         Foydalanuvchi? @relation("KategoriyaEgasi", fields: [egaId], references: [id])
  tovarlar    Tovar[]

  @@unique([nomi, filialId, egaId])
  @@index([omborId])
  @@index([filialId])
  @@index([egaId])
  @@map("kategoriyalar")
}

// ========================
// TOVARLAR
// ========================
model Tovar {
  id            String    @id @default(cuid())
  nomi          String
  kategoriyaId  String
  shtrixKod     String?
  filialId      String?
  // Filialsiz (filialId=null) mahsulot kimning katalogiga tegishli ekanini
  // belgilaydi — Ega o'zining shu belgi bilan ulashgan adminlariga ham
  // xuddi shu qatorlar ko'rinadi (nusxa emas, jonli so'rov orqali).
  egaId         String?
  kelishNarxi   Decimal   @db.Decimal(12, 2)
  sotishNarxi   Decimal   @db.Decimal(12, 2)
  // Ikkalasi ham ixtiyoriy — kiritilmasa oddiy sotish narxi ishlatiladi.
  optomNarxi    Decimal?  @db.Decimal(12, 2)
  bolishNarxi   Decimal?  @db.Decimal(12, 2)
  birlik        Birlik    @default(DONA)
  minimalQoldiq Int       @default(5)
  // Mahsulotni yetkazib beruvchi. Ixtiyoriy: "bu tovar kimdan keladi"
  // degan savolga javob beradi va qayta buyurtma berishda ishlatiladi.
  // Har bir yetkazib berish esa OmborHarakati.taminotchiId da alohida
  // yoziladi (bir tovar turli paytda boshqa ta'minotchidan kelishi mumkin).
  taminotchiId  String?
  // Tovar qayerdan keltirilgani — erkin matn (bozor, ombor, shahar, do'kon
  // nomi va h.k.). `taminotchiId` "kim yetkazib berdi" degan savolga javob
  // beradi, bu esa "qayerdan olib kelindi" degan savolga: ba'zi tovarlar
  // ro'yxatdagi ta'minotchisiz, oddiy bozordan olib kelinadi.
  keltirilganManzil String?
  // Mahsulot YARATILGAN paytdagi USD kursi (Markaziy bank).
  // Keyin kurs o'zgarsa ham "shu tovar qanday kursda kiritilgan edi"
  // degan savolga javob beradi. Eski qatorlarda null bo'lib qoladi —
  // ular kurs saqlana boshlaguncha yaratilgan.
  yaratilganKursi Decimal? @db.Decimal(12, 2)
  // Qulflangan tovar SOTUVDA ko'rinmaydi va sotib bo'lmaydi, lekin
  // katalogda, omborda va hisobotlarda o'z joyida qoladi.
  // `holati=ARXIVLANGAN` dan farqi: arxivlash — tovarni butunlay
  // ishdan chiqarish, qulflash esa vaqtinchalik va bir bosishda qaytariladi.
  qulflangan    Boolean   @default(false)
  rasmlar       String[]  @default([])
  yaroqlilikMuddati DateTime?
  valyuta       Valyuta   @default(UZS)
  holati        TovarHolati @default(FAOL)
  yaratilgan    DateTime  @default(now())
  yangilangan   DateTime  @updatedAt

  kategoriya       Kategoriya         @relation(fields: [kategoriyaId], references: [id])
  taminotchi       Taminotchi?        @relation(fields: [taminotchiId], references: [id])
  filial           Filial?            @relation(fields: [filialId], references: [id])
  ega              Foydalanuvchi?     @relation("TovarEgasi", fields: [egaId], references: [id])
  omborHarakati    OmborHarakati[]
  sotuvTarkibi     SotuvTarkibi[]
  qaytarishTarkibi QaytarishTarkibi[]
  sherikdanOlishlar SherikdanOlish[]
  buyurtmaTarkibi  BuyurtmaTarkibi[]
  xaridTarkibi     XaridTarkibi[]
  otkazmaManbasi   OtkazmaTarkibi[] @relation("OtkazmaManbaTovar")
  otkazmaQabuli    OtkazmaTarkibi[] @relation("OtkazmaQabulTovar")
  sorovTarkibi     TaminotchiSorovTarkibi[]
  onlaynRezervlar   OnlaynRezerv[]
  kartochka        TovarKartochka?
  namunalar        NamunaTarkibi[]

  @@unique([shtrixKod, filialId])
  @@index([holati])
  @@index([holati, qulflangan])
  @@index([kategoriyaId])
  @@index([taminotchiId])
  @@index([filialId])
  @@index([egaId])
  @@map("tovarlar")
}

// Bog'langan admin hisobidan mahsulotlarning ayrim maydonlarini
// (masalan kelish narxi) yashirish — Ega tovarlar sahifasida
// galichka orqali belgilaydi, barcha mahsulotlarga bir xilda tegishli.
model MaydonYashirish {
  id              String   @id @default(cuid())
  foydalanuvchiId String
  maydon          String
  yaratilgan      DateTime @default(now())

  foydalanuvchi   Foydalanuvchi @relation(fields: [foydalanuvchiId], references: [id], onDelete: Cascade)

  @@unique([foydalanuvchiId, maydon])
  @@index([foydalanuvchiId])
  @@map("maydon_yashirish")
}

enum Birlik {
  DONA
  KG
  LITR
  METR
  PACHKA
  QUTI
}

enum TovarHolati {
  FAOL
  ARXIVLANGAN
}

enum Valyuta {
  UZS
  USD
}

// ========================
// OMBOR HARAKATI
// ========================
model OmborHarakati {
  id              String         @id @default(cuid())
  tovarId         String
  turi            HarakatTuri
  joy             Joylashuv      @default(OMBOR)
  miqdor          Decimal        @db.Decimal(12, 3)
  narx            Decimal        @db.Decimal(12, 2)
  taminotchiId    String?
  sotuvId         String?
  otkazmaId       String?
  izoh            String?
  sana            DateTime       @default(now())
  foydalanuvchiId String

  tovar           Tovar          @relation(fields: [tovarId], references: [id])
  taminotchi      Taminotchi?    @relation(fields: [taminotchiId], references: [id])
  sotuv           Sotuv?         @relation(fields: [sotuvId], references: [id])
  otkazma         Otkazma?       @relation(fields: [otkazmaId], references: [id])
  foydalanuvchi   Foydalanuvchi  @relation(fields: [foydalanuvchiId], references: [id])

  @@index([tovarId])
  @@index([tovarId, turi, joy])
  @@index([sotuvId])
  @@index([otkazmaId])
  @@index([sana])
  @@map("ombor_harakati")
}

enum HarakatTuri {
  KIRIM
  CHIQIM
  QAYTARISH
  YOQOTISH
  // Filial ICHIDA: ombordan do'konga ko'chirish (bitta mahsulot ichida).
  OTKAZMA
  // Filiallar ORASIDA o'tkazma. Ataylab alohida turlar: OTKAZMA'ni
  // qayta ishlatib bo'lmaydi, chunki qoldiq hisobida u joy'ga qaramay
  // do'kon qoldig'ini oshiradi — manba mahsulot yolg'ondan boyib ketardi.
  OTKAZMA_CHIQIM
  OTKAZMA_KIRIM
}

enum Joylashuv {
  OMBOR
  DOKON
}

// ========================
// MIJOZLAR
// ========================
model Mijoz {
  id            String   @id @default(cuid())
  ism           String
  telefon       String?
  // Ikkinchi raqam — ko'pincha Telegram ulangan raqam yoki qarindoshining
  // raqami. Asosiy raqam javob bermaganda bog'lanish uchun.
  telefon2      String?
  // 3-raqam va undan keyingilari (9 raqam, +998 siz) — ishxona, turmush o'rtog'i,
  // ikkinchi telefon. Dublikat tekshiruvi va qidiruv bularni ham ko'radi.
  qoshimchaTelefonlar String[] @default([])
  // Hudud qo'lda belgilanadi: ro'yxatdan tanlanadi yoki erkin yoziladi
  // (ro'yxatda yo'q joy nomi ham yo'qolib qolmasin). manzil esa ko'cha/uy
  // darajasidagi tafsilot uchun qoladi.
  viloyat       String?
  tuman         String?
  manzil        String?
  // GPS orqali qo'lda belgilangan joylashuv (masalan mijoz oldiga borib olingan) —
  // manzil matni bilan bir qatorda, mustaqil ixtiyoriy maydon.
  lokatsiyaLat  Float?
  lokatsiyaLng  Float?
  izoh          String?
  // Sodiqlik dasturi — IKKITA mustaqil hisob. Balans shu yerda saqlanadi,
  // har bir o'zgarish esa SodiqlikHarakati jurnalida (audit izi bilan).
  // Balansni jurnaldan qayta hisoblash mumkin, lekin har o'qishda
  // yig'indi hisoblamaslik uchun tayyor ustun ham yuritiladi.
  ballBalans    Decimal  @default(0) @db.Decimal(12, 2)
  keshbekBalans Decimal  @default(0) @db.Decimal(12, 2)
  maxsus_kod    String?  @unique
  telegram_id   String?  @unique
  // Telegram'da topilmagan mijozlar uchun flag — qayta urinmaslik (PEER_FLOOD risk).
  // Birinchi "Telegram yo'q" xato'sida true qilinadi, mijoz ulanmagunicha shu qoladi.
  // Admin qo'lda false qilib qaytarishi mumkin (mijoz Telegram qo'shsa).
  telegramYoq   Boolean  @default(false)
  filialId      String?
  // Filialsiz (filialId=null) mijoz kimning katalogiga tegishli ekanini
  // belgilaydi — Tovar.egaId bilan bir xil naqsh (ulashilgan adminlar
  // xuddi shu qatorlarni jonli ko'radi, nusxa emas).
  egaId         String?
  yaratilgan    DateTime @default(now())

  filial          Filial?  @relation(fields: [filialId], references: [id])
  ega             Foydalanuvchi?    @relation("MijozEgasi", fields: [egaId], references: [id])
  sotuvlar        Sotuv[]
  nasiyalar       Nasiya[]
  bildirishnomlar BildirishnomLog[]
  buyurtmalar     Buyurtma[]
  sodiqlikHarakatlari SodiqlikHarakati[]

  @@index([filialId])
  @@index([egaId])
  @@index([viloyat])
  @@map("mijozlar")
}

// ========================
// SOTUV
// ========================
model Sotuv {
  id             String      @id @default(cuid())
  chekRaqami     String      @unique
  mijozId        String?
  jamiSumma      Decimal     @db.Decimal(12, 2)
  chegirma       Decimal     @default(0) @db.Decimal(12, 2)
  yakuniySumma   Decimal     @db.Decimal(12, 2)
  tolovUsuli     TolovUsuli  @default(NAQD)
  // Pul qaysi kanal orqali tushgani. Bitta usulli sotuvda faqat bittasi
  // to'ladi, ARALASH'da esa naqd + tanlangan ikkinchi kanal bo'linadi.
  // NASIYA/SHERIK'da hammasi 0 — pul sotuv paytida tushmaydi.
  naqdTolangan   Decimal     @default(0) @db.Decimal(12, 2)
  kartaTolangan  Decimal     @default(0) @db.Decimal(12, 2)
  clickTolangan  Decimal     @default(0) @db.Decimal(12, 2)
  bankTolangan   Decimal     @default(0) @db.Decimal(12, 2)
  // Shu sotuvda sodiqlik hisobidan qoplangan qism. Chegirmadan ALOHIDA
  // yuritiladi — aks holda hisobotlarda "chegirma berdik" bilan "mijoz
  // o'z ballini ishlatdi" bir-biriga qo'shilib ketardi.
  ballIshlatilgan    Decimal @default(0) @db.Decimal(12, 2)
  keshbekIshlatilgan Decimal @default(0) @db.Decimal(12, 2)
  kassirId       String
  holati         SotuvHolati @default(YAKUNLANGAN)
  sana           DateTime    @default(now())

  sherikDokonId  String?
  filialId       String?
  egaId          String?

  // Sotuv qayerdan keldi. Onlayn do'kon buyurtmasi topshirilganda ERP
  // o'zi sotuv yaratadi — hisobotlarda kassadagidan ajratib ko'rish uchun.
  manba          SotuvManba  @default(POS)
  // Onlayn buyurtma raqami (MP-2026-00001). Yagona — bir buyurtma ikki
  // marta sotuvga aylanmasin (tugma ikki marta bosilsa ham).
  onlaynRaqam    String?     @unique
  // Yetkazish haqi mahsulot summasidan ALOHIDA: `yakuniySumma` faqat
  // mahsulotlar — foyda va sotuv hisobotlari buzilmasin.
  yetkazishNarx  Decimal     @default(0) @db.Decimal(12, 2)

  mijoz          Mijoz?          @relation(fields: [mijozId], references: [id])
  kassir         Foydalanuvchi   @relation(fields: [kassirId], references: [id])
  sherikDokon    SherikDokon?    @relation(fields: [sherikDokonId], references: [id])
  filial         Filial?         @relation(fields: [filialId], references: [id])
  ega            Foydalanuvchi?  @relation("SotuvEgasi", fields: [egaId], references: [id])
  tarkiblar      SotuvTarkibi[]
  nasiya         Nasiya?
  omborHarakati  OmborHarakati[]
  qaytarishlar       Qaytarish[]
  sherikdanOlishlar  SherikdanOlish[]
  sodiqlikHarakatlari SodiqlikHarakati[]

  @@index([filialId])
  @@index([egaId])
  @@map("sotuvlar")
}

enum TolovUsuli {
  NAQD
  KARTA
  CLICK
  BANK
  ARALASH
  NASIYA
  SHERIK
}

// ========================
// ONLAYN VITRINA KARTOCHKASI
// ========================
// Mahsulotning onlayn do'kondagi ko'rinishi. Tovar jadvalidan ALOHIDA: kassa
// va ombor so'rovlari (har kuni minglab) tavsif va xususiyatlarni tortib
// yurmasin. Rasmlar esa `Tovar.rasmlar` da qoladi — kassa ham, sayt ham bitta
// manbadan ko'radi.
model TovarKartochka {
  id           String   @id @default(cuid())
  tovarId      String   @unique
  // Onlayn do'konda ko'rinadimi. Standart — yo'q: mahsulot ataylab chiqariladi.
  saytda       Boolean  @default(false)
  // Saytdagi nom. Bo'sh bo'lsa ERP nomi ishlatiladi (kirill nomlarni lotinda
  // chiroyli yozish yoki "1 k × 16 b" kabi ichki qisqartmalarni ochish uchun).
  sarlavha     String?
  brend        String?
  tavsif       String?
  // [{ nomi: "Hajmi", qiymat: "400 ml" }, ...] — tartib saqlanadi
  xususiyatlar Json     @default("[]")
  // Birlik narxi uchun: 400 + ML → "115 so'm / 1 ml". Ikkalasi birga bo'ladi.
  hajm         Decimal? @db.Decimal(12, 3)
  hajmBirligi  HajmBirligi?

  // ── Aksiya ─────────────────────────────────────────────────────────────
  // Aksiya narxi KASSADA HAM amal qiladi: boshlanganda ERP `Tovar.sotishNarxi`
  // ni o'zi aksiya narxiga almashtiradi, tugaganda eski narxni qaytaradi.
  // Sayt "kassadagi narx bilan bir xil" deb va'da beradi — bu va'da buzilmaydi.
  aksiyaNarxi      Decimal?  @db.Decimal(12, 2)
  aksiyaBoshi      DateTime?
  aksiyaOxiri      DateTime?
  // Qo'llangan paytdagi asl narx (null — aksiya hali boshlanmagan yoki yo'q)
  aksiyaEskiNarx   Decimal?  @db.Decimal(12, 2)

  yaratilgan   DateTime @default(now())
  yangilangan  DateTime @updatedAt

  tovar Tovar @relation(fields: [tovarId], references: [id], onDelete: Cascade)

  @@index([saytda])
  @@index([aksiyaBoshi, aksiyaOxiri])
  @@map("tovar_kartochkalari")
}

enum HajmBirligi {
  G
  KG
  ML
  L
  DONA
  M
}

enum SotuvManba {
  POS
  ONLAYN
}

// ========================
// ONLAYN BUYURTMA REZERVI
// ========================
// Onlayn buyurtma tasdiqlanganda mahsulot "band" qilinadi. Qoldiqning
// o'zi o'zgarmaydi (hali hech narsa sotilmagan) — lekin saytdagi mavjudlik
// band qilinganni ayirib hisoblanadi, ikkinchi xaridor oxirgi donani
// ololmaydi. Topshirilganda haqiqiy sotuvga aylanadi, bekor bo'lsa bo'shaydi.
enum RezervHolati {
  FAOL
  SOTILDI
  BOSHATILDI
}

model OnlaynRezerv {
  id              String       @id @default(cuid())
  buyurtmaRaqami  String
  tovarId         String
  miqdor          Decimal      @db.Decimal(12, 3)
  holati          RezervHolati @default(FAOL)
  // Muddati o'tgan faol rezerv hisobga olinmaydi — unutilgan buyurtma
  // mahsulotni abadiy band qilib qo'ymasin.
  amalQiladi      DateTime
  foydalanuvchiId String
  yaratilgan      DateTime     @default(now())
  yangilangan     DateTime     @updatedAt

  tovar         Tovar         @relation(fields: [tovarId], references: [id])
  foydalanuvchi Foydalanuvchi @relation("OnlaynRezervlar", fields: [foydalanuvchiId], references: [id])

  @@unique([buyurtmaRaqami, tovarId])
  @@index([tovarId, holati, amalQiladi])
  @@map("onlayn_rezervlar")
}

enum SotuvHolati {
  YAKUNLANGAN
  BEKOR_QILINGAN
}

// ========================
// SOTUV TARKIBI
// ========================
model SotuvTarkibi {
  id          String   @id @default(cuid())
  sotuvId     String
  tovarId     String
  miqdor      Decimal  @db.Decimal(12, 3)
  birlikNarxi Decimal  @db.Decimal(12, 2)
  chegirma    Decimal  @default(0) @db.Decimal(12, 2)
  jami        Decimal  @db.Decimal(12, 2)

  sotuv       Sotuv    @relation(fields: [sotuvId], references: [id])
  tovar       Tovar    @relation(fields: [tovarId], references: [id])

  @@map("sotuv_tarkibi")
}

// ========================
// NASIYA
// ========================
model Nasiya {
  id          String       @id @default(cuid())
  sotuvId     String?      @unique
  mijozId     String
  jamiQarz    Decimal      @db.Decimal(12, 2)
  tolangan    Decimal      @default(0) @db.Decimal(12, 2)
  qoldiq      Decimal      @db.Decimal(12, 2)
  muddat      DateTime?
  holati      NasiyaHolati @default(OCHIQ)
  sana        DateTime     @default(now())
  ochirilgan  Boolean      @default(false)

  sotuv       Sotuv?       @relation(fields: [sotuvId], references: [id])
  mijoz       Mijoz        @relation(fields: [mijozId], references: [id])
  tolovlar    NasiyaTolov[]
  qarzTarixi  NasiyaQarzTarixi[]
  bildirishnomlar BildirishnomLog[]

  @@index([holati, muddat])
  @@map("nasiyalar")
}

enum NasiyaHolati {
  OCHIQ
  YOPILGAN
  MUDDATI_OTGAN
}

// ========================
// NASIYA TO'LOV
// ========================
model NasiyaTolov {
  id                String        @id @default(cuid())
  nasiyaId          String
  summa             Decimal       @db.Decimal(12, 2)
  tolovUsuli        TolovUsuli    @default(NAQD)
  qabulQiluvchiId   String
  izoh              String?
  sana              DateTime      @default(now())

  nasiya            Nasiya        @relation(fields: [nasiyaId], references: [id])
  qabulQiluvchi     Foydalanuvchi @relation(fields: [qabulQiluvchiId], references: [id])

  @@map("nasiya_tolovlar")
}

// ========================
// NASIYA QARZ TARIXI
// ========================
model NasiyaQarzTarixi {
  id         String   @id @default(cuid())
  nasiyaId   String
  summa      Decimal  @db.Decimal(12, 2)
  izoh       String?
  sana       DateTime @default(now())

  nasiya     Nasiya   @relation(fields: [nasiyaId], references: [id])

  @@index([nasiyaId])
  @@map("nasiya_qarz_tarixi")
}

// ========================
// TA'MINOTCHILAR
// ========================
model Taminotchi {
  id            String   @id @default(cuid())
  nomi          String
  kontaktShaxs  String?
  telefon       String?
  manzil        String?
  // Xaritadagi aniq nuqta. `manzil` matni bilan bir qatorda turadigan
  // MUSTAQIL maydon: manzil yozilmasdan ham koordinata bo'lishi mumkin
  // va aksincha. Ikkalasi ham NULL bo'lsa xaritada ko'rinmaydi.
  lokatsiyaLat  Float?
  lokatsiyaLng  Float?
  izoh          String?
  filialId      String?
  egaId         String?
  yaratilgan    DateTime @default(now())

  filial        Filial?  @relation(fields: [filialId], references: [id])
  ega           Foydalanuvchi? @relation("TaminotchiEgasi", fields: [egaId], references: [id])
  xaridlar      Xarid[]
  tovarlar      Tovar[]
  omborHarakati OmborHarakati[]
  sherikdanOlishlar      SherikdanOlish[]
  sherikdanOlishTolovlar SherikdanOlishTolov[]
  sorovlar               TaminotchiSorov[]
  qarzlari               TaminotchiQarz[]

  @@index([filialId])
  @@index([egaId])
  @@map("taminotchilar")
}

// ========================
// XARID (TA'MINOTCHIDAN)
// ========================
model Xarid {
  id              String        @id @default(cuid())
  taminotchiId    String
  jamiSumma       Decimal       @db.Decimal(12, 2)
  tolangan        Decimal       @default(0) @db.Decimal(12, 2)
  qoldiqQarz      Decimal       @db.Decimal(12, 2)
  izoh            String?
  sana            DateTime      @default(now())
  foydalanuvchiId String

  taminotchi      Taminotchi    @relation(fields: [taminotchiId], references: [id])
  foydalanuvchi   Foydalanuvchi @relation(fields: [foydalanuvchiId], references: [id])
  tarkiblar       XaridTarkibi[]
  tolovlar        XaridTolov[]
  qarzTarixi      XaridQarzTarixi[]

  @@map("xaridlar")
}

// ========================
// XARID QARZ TARIXI
// ========================
model XaridQarzTarixi {
  id         String   @id @default(cuid())
  xaridId    String
  summa      Decimal  @db.Decimal(12, 2)
  izoh       String?
  sana       DateTime @default(now())

  xarid      Xarid    @relation(fields: [xaridId], references: [id])

  @@index([xaridId])
  @@map("xarid_qarz_tarixi")
}

// ========================
// XARID TO'LOV
// ========================
model XaridTolov {
  id              String        @id @default(cuid())
  xaridId         String
  summa           Decimal       @db.Decimal(12, 2)
  tolovUsuli      TolovUsuli    @default(NAQD)
  qabulQiluvchiId String
  izoh            String?
  sana            DateTime      @default(now())

  xarid           Xarid         @relation(fields: [xaridId], references: [id])
  qabulQiluvchi   Foydalanuvchi @relation("xaridTolovlar", fields: [qabulQiluvchiId], references: [id])

  @@map("xarid_tolovlar")
}

// ========================
// XARID TARKIBI
// ========================
model XaridTarkibi {
  id          String  @id @default(cuid())
  xaridId     String
  tovarId     String?
  tovarNomi   String
  miqdor      Decimal @db.Decimal(12, 3)
  birlikNarxi Decimal @db.Decimal(12, 2)
  jami        Decimal @db.Decimal(12, 2)

  xarid       Xarid   @relation(fields: [xaridId], references: [id])
  tovar       Tovar?  @relation(fields: [tovarId], references: [id])

  @@map("xarid_tarkibi")
}

// ========================
// XARAJATLAR
// ========================
model Xarajat {
  id              String           @id @default(cuid())
  kategoriya      XarajatKategoriya
  summa           Decimal          @db.Decimal(12, 2)
  izoh            String?
  // Xarajat KIM uchun qilingani. Xodimga bog'langan bo'lsa `xodimId`
  // to'ldiriladi (masalan "Jasurga obed puli"), aks holda `kimUchun`
  // erkin matn bo'ladi ("Damas mashina", "Soliq inspeksiyasi").
  xodimId         String?
  kimUchun        String?
  // Qaysi kanal orqali to'landi — To'lovlar bo'limi shu bo'yicha guruhlaydi.
  tolovUsuli      TolovUsuli?
  sana            DateTime         @default(now())
  foydalanuvchiId String
  filialId        String?
  egaId           String?

  foydalanuvchi   Foydalanuvchi    @relation(fields: [foydalanuvchiId], references: [id])
  xodim           Foydalanuvchi?   @relation("XarajatXodimi", fields: [xodimId], references: [id])
  filial          Filial?          @relation(fields: [filialId], references: [id])
  ega             Foydalanuvchi?   @relation("XarajatEgasi", fields: [egaId], references: [id])
  xodimTolovi     XodimTolov?

  @@index([filialId])
  @@index([egaId])
  @@index([xodimId])
  @@map("xarajatlar")
}

enum XarajatKategoriya {
  IJARA
  MAOSH
  TRANSPORT
  KOMMUNAL
  OVQAT     // ovqat, choy-nonushta
  SOLIQ     // soliq va yig'imlar
  TAMIRLASH // ta'mirlash, ehtiyot qism
  REKLAMA
  BOSHQA
}

// ========================
// SOZLAMALAR (SETTINGS)
// ========================
model Sozlama {
  id         String   @id @default(cuid())
  kalit      String   @unique
  qiymat     String
  yangilangan DateTime @updatedAt

  @@map("sozlamalar")
}

// ========================
// SHERIK DO'KONLAR (PARTNER STORES - credit sales)
// ========================
model SherikDokon {
  id         String   @id @default(cuid())
  nomi       String
  telefon    String?
  manzil     String?
  izoh       String?
  yaratilgan DateTime @default(now())

  sotuvlar   Sotuv[]
  tolovlar   SherikDokonTolov[]

  @@map("sherik_dokonlar")
}

model SherikDokonTolov {
  id            String      @id @default(cuid())
  sherikDokonId String
  summa         Decimal     @db.Decimal(12, 2)
  izoh          String?
  sana          DateTime    @default(now())

  sherikDokon   SherikDokon @relation(fields: [sherikDokonId], references: [id])

  @@map("sherik_dokon_tolovlar")
}

// ========================
// AGENTLAR (product loan tracking, was Sheriklar)
// ========================
model Sherik {
  id         String   @id @default(cuid())
  ism        String
  telefon    String?
  telefon2   String?
  manzil     String?
  tavsif     String?
  faol       Boolean  @default(true)
  yaratilgan DateTime @default(now())

  qarzlar    SherikQarz[]
  sherikdanOlishlar      SherikdanOlish[]
  sherikdanOlishTolovlar SherikdanOlishTolov[]

  @@map("sheriklar")
}

// ========================
// SHERIK QARZLARI (PRODUCT LOANS)
// ========================
model SherikQarz {
  id         String           @id @default(cuid())
  sherikId   String
  izoh       String?
  holati     SherikQarzHolati @default(OCHIQ)
  yaratilgan DateTime         @default(now())

  sherik    Sherik              @relation(fields: [sherikId], references: [id])
  tarkiblar SherikQarzTarkibi[]

  @@map("sherik_qarzlar")
}

// ========================
// SHERIKDAN OLISH (tovar olib kelish yoki qarz qo'shish)
// ========================
model SherikdanOlish {
  id           String   @id @default(cuid())
  sotuvId      String?
  sherikId     String?
  taminotchiId String?
  tovarId      String?
  miqdor       Decimal  @db.Decimal(12, 3)
  narx         Decimal  @db.Decimal(12, 2)
  jami         Decimal  @db.Decimal(12, 2)
  izoh         String?
  yaratilgan   DateTime @default(now())

  sotuv       Sotuv?       @relation(fields: [sotuvId], references: [id])
  sherik      Sherik?      @relation(fields: [sherikId], references: [id])
  taminotchi  Taminotchi?  @relation(fields: [taminotchiId], references: [id])
  tovar       Tovar?       @relation(fields: [tovarId], references: [id])

  tolovlar SherikdanOlishTolov[]
  @@map("sherikdan_olish")
}

model SherikdanOlishTolov {
  id                String   @id @default(cuid())
  sherikdanOlishId  String?
  sherikId          String?
  taminotchiId      String?
  summa             Decimal  @db.Decimal(12, 2)
  turi              String   // "PUL" | "TOVAR"
  izoh              String?
  yaratilgan        DateTime @default(now())

  sherikdanOlish SherikdanOlish? @relation(fields: [sherikdanOlishId], references: [id])
  sherik         Sherik?         @relation(fields: [sherikId], references: [id])
  taminotchi     Taminotchi?     @relation(fields: [taminotchiId], references: [id])
  @@map("sherikdan_olish_tolov")
}

model SherikQarzTarkibi {
  id           String     @id @default(cuid())
  sherikQarzId String
  tovarNomi    String
  miqdor       Decimal    @db.Decimal(12, 3)
  birlik       String     @default("dona")
  qaytarilgan  Decimal    @default(0) @db.Decimal(12, 3)

  sherikQarz SherikQarz @relation(fields: [sherikQarzId], references: [id])

  @@map("sherik_qarz_tarkibi")
}

enum SherikQarzHolati {
  OCHIQ
  QISMAN
  YOPILGAN
}

// ========================
// QAYTARISH
// ========================
model Qaytarish {
  id         String   @id @default(cuid())
  aslSotuvId String
  kassirId   String
  jamiSumma  Decimal  @db.Decimal(12, 2)
  sabab      String?
  yaratilgan DateTime @default(now())

  aslSotuv  Sotuv          @relation(fields: [aslSotuvId], references: [id])
  kassir    Foydalanuvchi  @relation(fields: [kassirId], references: [id])
  tarkiblar QaytarishTarkibi[]

  @@map("qaytarishlar")
}

model QaytarishTarkibi {
  id          String   @id @default(cuid())
  qaytarishId String
  tovarId     String
  miqdor      Decimal  @db.Decimal(12, 3)
  birlikNarxi Decimal  @db.Decimal(12, 2)
  jami        Decimal  @db.Decimal(12, 2)

  qaytarish Qaytarish @relation(fields: [qaytarishId], references: [id])
  tovar     Tovar     @relation(fields: [tovarId], references: [id])

  @@map("qaytarish_tarkibi")
}

// ========================
// BUYURTMALAR (SOTUVCHI → KASSIR)
// ========================
// Saqlab qo'yilgan savat ("zakaz"): kassir mijoz uchun mahsulot yig'ib
// qo'yadi, keyin o'sha savatni qaytarib yuklab savdoni davom ettiradi.
//
// Ataylab serverda saqlanadi (brauzer xotirasida emas): boshqa kassir
// yoki boshqa qurilmadan ham ochib davom ettirish mumkin bo'lsin.
model Buyurtma {
  id          String         @id @default(cuid())
  sotuvchiId  String
  mijozId     String?
  holati      BuyurtmaHolati @default(KUTILMOQDA)
  jamiSumma   Decimal        @db.Decimal(12, 2)
  // "Kimga va nima uchun" — saqlashda yoziladi, ro'yxatda ko'rinib turadi.
  izoh        String?
  // Doiralash — Sotuv bilan bir xil naqsh. Busiz bir do'konning saqlangan
  // zakazlari boshqasining kassasida ko'rinib qolardi.
  filialId    String?
  egaId       String?
  yaratilgan  DateTime       @default(now())
  yangilangan DateTime       @updatedAt

  sotuvchi    Foydalanuvchi  @relation(fields: [sotuvchiId], references: [id])
  mijoz       Mijoz?         @relation(fields: [mijozId], references: [id])
  filial      Filial?        @relation(fields: [filialId], references: [id])
  ega         Foydalanuvchi? @relation("BuyurtmaEgasi", fields: [egaId], references: [id])
  tarkiblar   BuyurtmaTarkibi[]

  @@index([holati, yaratilgan])
  @@index([filialId])
  @@index([egaId])
  @@map("buyurtmalar")
}

model BuyurtmaTarkibi {
  id          String   @id @default(cuid())
  buyurtmaId  String
  tovarId     String
  miqdor      Decimal  @db.Decimal(12, 3)
  birlikNarxi Decimal  @db.Decimal(12, 2)
  jami        Decimal  @db.Decimal(12, 2)

  buyurtma    Buyurtma @relation(fields: [buyurtmaId], references: [id], onDelete: Cascade)
  tovar       Tovar    @relation(fields: [tovarId], references: [id])

  @@map("buyurtma_tarkibi")
}

enum BuyurtmaHolati {
  KUTILMOQDA
  TASDIQLANGAN
  BEKOR_QILINGAN
}

// ========================
// BILDIRISHNOM LOG
// ========================
model BildirishnomLog {
  id             String   @id @default(cuid())
  nasiyaId       String?
  mijozId        String
  xabarTuri      String   // "nasiya_yaratildi", "qarz_qoshildi", "tolov_qilindi", "3_kun", "2_kun", "1_kun", "muddati_otgan"
  xabarMatni     String?  // Yuborilgan xabarning to'liq matni
  telegramTarget String?  // Yuborilgan telefon raqam
  status         String   @default("pending") // "pending", "sending", "sent", "failed", "queued"
  yuborildi      Boolean  @default(false)
  xato           String?
  urinishSoni    Int      @default(0)
  maxUrinish     Int      @default(3)        // Maksimal urinishlar soni — keyin 'failed'
  keyingiUrinish DateTime?                   // Exponential backoff: next retry time
  sana           DateTime @default(now())
  yuborilganSana DateTime?

  nasiya         Nasiya?  @relation(fields: [nasiyaId], references: [id])
  mijoz          Mijoz    @relation(fields: [mijozId], references: [id])

  @@index([status, sana])
  @@index([status, keyingiUrinish])
  @@index([xabarTuri])
  @@map("bildirishnom_loglar")
}

// ========================
// SODIQLIK (BALLAR VA KESHBEKLAR)
// ========================
// Har bir o'zgarish shu jurnalga yoziladi: sotuvdan to'plangan, kassada
// sarflangan yoki admin qo'lda tuzatgan. `balansKeyin` — harakatdan keyingi
// balans, ya'ni har qatorga qarab "o'shanda qancha edi" deb aytish mumkin.
model SodiqlikHarakati {
  id          String          @id @default(cuid())
  mijozId     String
  hisob       SodiqlikHisobi
  /** Musbat — qo'shildi, manfiy — sarflandi. */
  miqdor      Decimal         @db.Decimal(12, 2)
  balansKeyin Decimal         @db.Decimal(12, 2)
  sabab       SodiqlikSabab
  sotuvId     String?
  izoh        String?
  foydalanuvchiId String?
  sana        DateTime        @default(now())

  mijoz         Mijoz          @relation(fields: [mijozId], references: [id], onDelete: Cascade)
  sotuv         Sotuv?         @relation(fields: [sotuvId], references: [id])
  foydalanuvchi Foydalanuvchi? @relation(fields: [foydalanuvchiId], references: [id])

  @@index([mijozId, sana])
  @@index([sotuvId])
  @@index([sana])
  @@map("sodiqlik_harakatlari")
}

enum SodiqlikHisobi {
  BALL
  KESHBEK
}

enum SodiqlikSabab {
  SOTUVDAN      // xariddan to'plandi
  SARFLANDI     // kassada chegirma sifatida ishlatildi
  QAYTARISHDAN  // tovar qaytarilgani uchun bekor qilindi
  QOLDA         // admin qo'lda tuzatdi
}

// ========================
// FILIALLARARO O'TKAZMA
// ========================
// Bir omborda ortib qolgan tovarni boshqasiga o'tkazish. Bir bosqichli:
// tasdiqlash kutilmaydi, hujjat yaratilishi bilan ikkala tomonning qoldig'i
// darhol o'zgaradi.
//
// Hujjat (Otkazma + OtkazmaTarkibi) va zaxira jurnali (OmborHarakati)
// alohida yuritiladi — Sotuv/SotuvTarkibi bilan aynan bir xil naqsh.
model Otkazma {
  id             String    @id @default(cuid())
  // null = Ega markaziy ombori (filialsiz katalog)
  manbaFilialId  String?
  qabulFilialId  String?
  manbaJoy       Joylashuv @default(OMBOR)
  qabulJoy       Joylashuv @default(OMBOR)
  izoh           String?
  sana           DateTime  @default(now())
  foydalanuvchiId String
  egaId          String?

  manbaFilial    Filial?       @relation("OtkazmaManba", fields: [manbaFilialId], references: [id])
  qabulFilial    Filial?       @relation("OtkazmaQabul", fields: [qabulFilialId], references: [id])
  foydalanuvchi  Foydalanuvchi @relation(fields: [foydalanuvchiId], references: [id])
  tarkiblar      OtkazmaTarkibi[]
  harakatlar     OmborHarakati[]

  @@index([sana])
  @@index([manbaFilialId])
  @@index([qabulFilialId])
  @@index([egaId])
  @@map("otkazmalar")
}

// Hujjat qatori. Manba va qabul mahsulot AYRIM qatorlar (har filialning
// o'z katalogi bor), shuning uchun ikkalasi ham saqlanadi — faqat
// harakatlardan qaysi mahsulot qaysiga o'tganini aniqlab bo'lmasdi.
model OtkazmaTarkibi {
  id           String  @id @default(cuid())
  otkazmaId    String
  manbaTovarId String
  qabulTovarId String
  miqdor       Decimal @db.Decimal(12, 3)
  // Manbaning kelish narxi — tannarx filiallar orasida sun'iy o'zgarmasin.
  narx         Decimal @db.Decimal(12, 2)

  otkazma      Otkazma @relation(fields: [otkazmaId], references: [id], onDelete: Cascade)
  manbaTovar   Tovar   @relation("OtkazmaManbaTovar", fields: [manbaTovarId], references: [id])
  qabulTovar   Tovar   @relation("OtkazmaQabulTovar", fields: [qabulTovarId], references: [id])

  @@index([otkazmaId])
  @@map("otkazma_tarkibi")
}

// Adminga ketadigan kunlik hisobot jurnali.
//
// BildirishnomLog'dan alohida: u MIJOZga ketadigan xabarlar uchun
// (`mijozId` majburiy), bu esa XODIMga (Ega/Admin) ketadigan ichki hisobot.
//
// `kunKaliti` — Toshkent vaqti bo'yicha "YYYY-MM-DD". Qabul qiluvchi bilan
// birgalikda unique: bir kunda bir adminга hisobot bir marta ketadi.
// Muvaffaqiyatsiz urinish shu qatorni yangilaydi (upsert), shuning uchun
// keyingi urinish takroriy xabar yubormaydi.
model KunlikHisobotLog {
  id              String   @id @default(cuid())
  kunKaliti       String
  qabulQiluvchiId String
  telefon         String?
  status          String   @default("pending") // pending | sent | failed | skipped
  xato            String?
  kamQolganSoni   Int      @default(0)
  tugaganSoni     Int      @default(0)
  matn            String?
  urinishSoni     Int      @default(0)
  sana            DateTime @default(now())
  yuborilganSana  DateTime?

  qabulQiluvchi   Foydalanuvchi @relation("KunlikHisobotlar", fields: [qabulQiluvchiId], references: [id], onDelete: Cascade)

  @@unique([kunKaliti, qabulQiluvchiId])
  @@index([sana])
  @@map("kunlik_hisobot_loglar")
}

// Ta'minotchiga yuborilgan mahsulot so'rovi (buyurtma).
//
// `Xarid` — mahsulot ALLAQACHON kelgandan keyingi hujjat (pul, qarz, qoldiq).
// Bu esa undan OLDINGI qadam: "menga shu narsalar kerak" degan xabar.
// Alohida model, chunki so'rov qoldiqqa ham, pulga ham ta'sir qilmaydi —
// u faqat aloqa hujjati va keyin nima buyurtma qilinganini eslab qolish uchun.
model TaminotchiSorov {
  id              String   @id @default(cuid())
  taminotchiId    String
  // Yuborilgan xabarning TO'LIQ matni. Keyin mahsulot nomi o'zgarsa ham
  // ta'minotchi aynan nimani olganini ko'rish uchun o'zgarmas nusxa.
  matn            String
  // Kassir qo'lda yozgan qo'shimcha qism (ixtiyoriy)
  qoshimchaIzoh   String?
  telefon         String?
  status          String   @default("pending") // pending | sent | failed
  xato            String?
  urinishSoni     Int      @default(0)
  sana            DateTime @default(now())
  yuborilganSana  DateTime?
  foydalanuvchiId String
  filialId        String?
  egaId           String?

  taminotchi      Taminotchi     @relation(fields: [taminotchiId], references: [id], onDelete: Cascade)
  foydalanuvchi   Foydalanuvchi  @relation("TaminotchiSorovlari", fields: [foydalanuvchiId], references: [id])
  filial          Filial?        @relation(fields: [filialId], references: [id])
  ega             Foydalanuvchi? @relation("TaminotchiSorovEgasi", fields: [egaId], references: [id])
  tarkiblar       TaminotchiSorovTarkibi[]

  @@index([taminotchiId, sana])
  @@index([filialId])
  @@index([egaId])
  @@map("taminotchi_sorovlari")
}

// So'rov qatori. `tovarId` ixtiyoriy: katalogda yo'q narsani qo'lda
// yozib qo'shish ham mumkin. `nomi` har doim nusxa sifatida saqlanadi —
// tovar keyin o'chirilsa ham so'rov tarixi o'qilishi kerak.
model TaminotchiSorovTarkibi {
  id       String  @id @default(cuid())
  sorovId  String
  tovarId  String?
  nomi     String
  miqdor   Decimal @db.Decimal(12, 3)
  birlik   String  @default("DONA")
  izoh     String?

  sorov    TaminotchiSorov @relation(fields: [sorovId], references: [id], onDelete: Cascade)
  tovar    Tovar?          @relation(fields: [tovarId], references: [id], onDelete: SetNull)

  @@index([sorovId])
  @@map("taminotchi_sorov_tarkibi")
}

enum XodimTolovTuri {
  OYLIK   // oylik maosh to'lovi
  BONUS   // mukofot
  AVANS   // oylikdan oldindan berilgan pul
  JARIMA  // ushlab qolingan summa
}

// Xodimga qilingan to'lov yoki undan ushlab qolingan summa.
//
// OYLIK/BONUS/AVANS — do'kondan chiqqan pul, shuning uchun ular
// `Xarajat` (kategoriya=MAOSH) yozuvini ham yaratadi va moliyaviy
// hisobotlarga tushadi. JARIMA esa pul chiqimi emas — u faqat xodim
// hisobini kamaytiradi, xarajat yaratmaydi.
model XodimTolov {
  id         String         @id @default(cuid())
  xodimId    String
  turi       XodimTolovTuri
  summa      Decimal        @db.Decimal(12, 2)
  // Qaysi oy uchun — "2026-09" ko'rinishida. Bonus/avans uchun ixtiyoriy.
  davr       String?
  izoh       String?
  sana       DateTime       @default(now())
  yaratganId String
  filialId   String?
  egaId      String?
  // Yaratilgan xarajat yozuvi — to'lov o'chirilsa u ham o'chiriladi.
  xarajatId  String?        @unique

  xodim      Foydalanuvchi  @relation("XodimTolovlari", fields: [xodimId], references: [id], onDelete: Cascade)
  yaratgan   Foydalanuvchi  @relation("XodimTolovYaratgan", fields: [yaratganId], references: [id])
  filial     Filial?        @relation(fields: [filialId], references: [id])
  xarajat    Xarajat?       @relation(fields: [xarajatId], references: [id], onDelete: SetNull)

  @@index([xodimId, sana])
  @@index([filialId])
  @@index([davr])
  @@map("xodim_tolovlari")
}

// Xodimga biriktirilgan mulk — mashina, telefon, kompyuter, kalit, asbob.
//
// Yozuv o'chirilmaydi: qaytarib olinsa yoki yo'qolsa `holati` o'zgaradi va
// `yakun*` maydonlari to'ldiriladi — kim qachon nimani olgan va qanday holatda
// qaytargani doim ko'rinib turadi. Boshqa xodimga o'tkazish = eskisini
// OTKAZILGAN qilib yopish + yangi xodimga yangi yozuv (bitta tranzaksiyada).
model XodimMulki {
  id            String     @id @default(cuid())
  xodimId       String
  turi          MulkTuri   @default(BOSHQA)
  nomi          String
  // Davlat raqami, IMEI, seriya yoki inventar raqami
  raqami        String?
  qiymati       Decimal?   @db.Decimal(14, 2)
  berilganSana  DateTime   @default(now())
  // Topshirilgandagi holati: "yangi", "o'ng eshigi tirnalgan"
  berilganHolat String?
  izoh          String?
  holati        MulkHolati @default(BERILGAN)
  yakunSana     DateTime?
  // Qaytarilgandagi holati, yo'qolish sababi yoki kimga o'tkazilgani
  yakunIzoh     String?
  yaratganId    String
  yakunlaganId  String?
  filialId      String?
  egaId         String?
  yaratilgan    DateTime   @default(now())
  yangilangan   DateTime   @updatedAt

  xodim         Foydalanuvchi  @relation("XodimMulklari", fields: [xodimId], references: [id], onDelete: Cascade)
  yaratgan      Foydalanuvchi  @relation("XodimMulkYaratgan", fields: [yaratganId], references: [id])
  yakunlagan    Foydalanuvchi? @relation("XodimMulkYakunlagan", fields: [yakunlaganId], references: [id], onDelete: SetNull)

  @@index([xodimId, holati])
  @@index([filialId])
  @@index([egaId])
  @@map("xodim_mulklari")
}

enum MulkTuri {
  TRANSPORT
  TELEFON
  KOMPYUTER
  ASBOB
  KALIT
  KIYIM
  BOSHQA
}

enum MulkHolati {
  BERILGAN
  QAYTARILGAN
  YOQOLGAN
  OTKAZILGAN
}

enum TaminotchiQarzTuri {
  QARZ   // qarz qo'shildi — biz ta'minotchiga qarzdor bo'ldik
  TOLOV  // to'lov qilindi — qarz kamaydi
}

// Ta'minotchi bilan QO'LDA yuritiladigan qarz daftari.
//
// Xarid orqali kelgan qarz `Xarid.qoldiqQarz` da hisoblanadi, lekin
// haqiqiy do'konda qarzning bir qismi tizimdan tashqarida paydo bo'ladi:
// tizim joriy qilinishidan oldingi qoldiq, og'zaki kelishuv, tuzatish.
// Shu jadval o'sha holatlarni yozib qo'yish uchun.
//
// Ta'minotchining umumiy qarzi = xaridlar qoldig'i + QARZ − TOLOV.
model TaminotchiQarz {
  id           String             @id @default(cuid())
  taminotchiId String
  turi         TaminotchiQarzTuri
  summa        Decimal            @db.Decimal(12, 2)
  // To'lov qaysi kanal orqali qilingani — To'lovlar bo'limi shu bo'yicha
  // guruhlaydi. QARZ yozuvida ma'nosiz, shuning uchun ixtiyoriy.
  tolovUsuli   TolovUsuli?
  izoh         String?
  sana         DateTime           @default(now())
  yaratganId   String
  filialId     String?
  egaId        String?

  taminotchi   Taminotchi         @relation(fields: [taminotchiId], references: [id], onDelete: Cascade)
  yaratgan     Foydalanuvchi      @relation("TaminotchiQarzYaratgan", fields: [yaratganId], references: [id])
  filial       Filial?            @relation(fields: [filialId], references: [id])

  @@index([taminotchiId, sana])
  @@index([filialId])
  @@map("taminotchi_qarzlari")
}

enum DokonQarzTuri {
  QARZ   // do'kon qarzdor bo'ldi
  TOLOV  // qarzning bir qismi to'landi
}

// DO'KONNING O'Z QARZI — kimdandir olingan qarz.
//
// Uchta qarz turi bir-biridan farq qiladi:
//   • `Nasiya`          — MIJOZ bizga qarzdor (sotuvdan)
//   • `TaminotchiQarz`  — biz TA'MINOTCHIGA qarzdormiz (tovar uchun)
//   • `DokonQarz`       — biz BOSHQA birovga qarzdormiz (ijara, qarz olingan
//                         pul, jismoniy shaxs) — ta'minotchi bilan bog'liq emas
//
// Kimga qarzdor ekanimiz erkin matn: bu odam ham, tashkilot ham bo'lishi
// mumkin va ularni alohida jadvalga yozish ortiqcha murakkablik bo'lardi.
model DokonQarz {
  id         String        @id @default(cuid())
  /** Kimga qarzdormiz — ism yoki tashkilot nomi. */
  kimga      String
  turi       DokonQarzTuri
  summa      Decimal       @db.Decimal(12, 2)
  /** To'lov kanali — To'lovlar bo'limi shu bo'yicha guruhlaydi. */
  tolovUsuli TolovUsuli?
  izoh       String?
  /** Qaytarish muddati — faqat QARZ yozuvida ma'noli. */
  muddat     DateTime?
  sana       DateTime      @default(now())
  yaratganId String
  filialId   String?
  egaId      String?

  yaratgan   Foydalanuvchi @relation("DokonQarzYaratgan", fields: [yaratganId], references: [id])
  filial     Filial?       @relation(fields: [filialId], references: [id])

  @@index([kimga])
  @@index([sana])
  @@index([filialId])
  @@map("dokon_qarzlari")
}

// OMBOR — kategoriyalarning ustki guruhi ("katta kategoriya").
//
// Iyerarxiya:  Ombor  →  Kategoriya  →  Tovar
//
// Do'konda tovarlar jismoniy joyga qarab ajratiladi (oziq-ovqat ombori,
// kimyo ombori, sovutgich va h.k.), har birida bir nechta kategoriya
// bo'ladi. Shu tuzilma POS'da ham ikki bosqichli filtr beradi:
// avval ombor, keyin uning ichidagi kategoriya.
//
// `OmborHarakati.joy` (OMBOR/DOKON) dan FARQ QILADI: u tovar qayerda
// turganini (sotuvda yoki zaxirada) bildiradi, bu esa qaysi omborga
// tegishli ekanini.
model Ombor {
  id            String       @id @default(cuid())
  nomi          String
  izoh          String?
  /** Ro'yxatda ko'rsatilish tartibi — eng ko'p ishlatilgani tepada. */
  tartib        Int          @default(0)
  faol          Boolean      @default(true)
  filialId      String?
  egaId         String?
  yaratilgan    DateTime     @default(now())

  filial        Filial?         @relation(fields: [filialId], references: [id])
  ega           Foydalanuvchi?  @relation("OmborEgasi", fields: [egaId], references: [id])
  kategoriyalar Kategoriya[]

  @@unique([nomi, filialId, egaId])
  @@index([filialId])
  @@index([egaId])
  @@map("omborlar")
}

// ========================
// DOSTAVCHIKLAR VA NAMUNA TOVARLAR
// ========================

enum TransportTuri {
  PIYODA
  VELOSIPED
  SKUTER
  MOTOTSIKL
  AVTOMOBIL
  YUK_AVTOMOBILI
  BOSHQA
}

// Dostavchikning tizimga kirish hisobi — oddiy `Foydalanuvchi` (rol DOSTAVCHIK).
// Bu yerda faqat unga xos narsalar: nima haydaydi va qo'shimcha raqamlari.
// Profil ixtiyoriy: Xodimlar bo'limida DOSTAVCHIK roli bilan yaratilgan
// xodimda u bo'lmasligi mumkin — "Namuna tovar" bo'limi baribir ko'rsatadi.
model DostavchikProfil {
  id                  String        @id @default(cuid())
  foydalanuvchiId     String        @unique
  transportTuri       TransportTuri @default(AVTOMOBIL)
  // Rusumi va rangi: "Chevrolet Damas, oq"
  transportNomi       String?
  // Davlat raqami: "01 A 123 BC"
  davlatRaqami        String?
  qoshimchaTelefonlar String[]      @default([])
  /// Yashash yoki ish manzili — matn ko'rinishida (mahalla, ko'cha, uy)
  manzil              String?
  /// O'sha manzilning xaritadagi nuqtasi: GPS, xaritadan bosish yoki
  /// Google/Yandex havolasidan olinadi
  manzilLat           Float?
  manzilLng           Float?
  izoh                String?
  yaratilgan          DateTime      @default(now())
  yangilangan         DateTime      @updatedAt

  foydalanuvchi Foydalanuvchi @relation("DostavchikProfili", fields: [foydalanuvchiId], references: [id], onDelete: Cascade)

  @@map("dostavchik_profillari")
}

enum YetkazishHolati {
  TAYINLANGAN
  YOLDA
  YETIB_KELDI
  TOPSHIRILDI
  BEKOR
}

// Onlayn buyurtma kimga biriktirilgan va yetkazish qaysi bosqichda.
//
// Buyurtmaning o'zi marketplace bazasida — bu yerda faqat ERP'ga tegishli
// qism: qaysi dostavchik olib boradi va qachon yo'lga chiqdi/yetib keldi/
// topshirdi. Mijoz nomi va manzili NUSXA qilib saqlanadi: dostavchik paneli
// har ochilganda marketplace'dan butun ro'yxatni so'ramasin.
model OnlaynYetkazish {
  id             String          @id @default(cuid())
  buyurtmaRaqami String          @unique
  dostavchikId   String
  holati         YetkazishHolati @default(TAYINLANGAN)
  aloqaIsm       String?
  aloqaTel       String?
  manzilMatni    String?
  lat            Float?
  lng            Float?
  jamiSumma      Decimal?        @db.Decimal(12, 2)
  tayinlaganId   String
  tayinlangan    DateTime        @default(now())
  yolgaChiqdi    DateTime?
  yetibKeldi     DateTime?
  topshirildi    DateTime?
  yangilangan    DateTime        @updatedAt

  dostavchik Foydalanuvchi @relation("DostavchikYetkazishlari", fields: [dostavchikId], references: [id])
  tayinlagan Foydalanuvchi @relation("YetkazishTayinlagan", fields: [tayinlaganId], references: [id])

  @@index([dostavchikId, holati])
  @@index([yangilangan])
  @@map("onlayn_yetkazishlar")
}

enum NamunaHolati {
  BERILGAN
  TOPSHIRILGAN
}

// Dostavchikka mijozlarga ko'rsatish uchun bir martada berilgan namunalar
// (masalan yangi kelgan partiyadan har biridan bittadan).
//
// Ombor qoldig'iga tegmaydi: namuna do'kondan vaqtincha chiqib, qaytib
// keladi. Qayerdaligi shu jadvalda — "hozir dostavchiklarda nima bor".
model NamunaBerish {
  id           String   @id @default(cuid())
  dostavchikId String
  izoh         String?
  berganId     String
  yaratilgan   DateTime @default(now())

  dostavchik Foydalanuvchi   @relation("DostavchikNamunalari", fields: [dostavchikId], references: [id])
  bergan     Foydalanuvchi   @relation("NamunaBergan", fields: [berganId], references: [id])
  tarkiblar  NamunaTarkibi[]

  @@index([dostavchikId, yaratilgan])
  @@map("namuna_berishlar")
}

// Bitta namuna. Tovar katalogdan tanlansa `tovarId` bor; katalogda yo'q
// narsa qo'lda yozilsa faqat `nomi`. Nomi har doim nusxa: tovar keyin
// o'zgartirilsa yoki o'chirilsa ham tarix buzilmaydi.
model NamunaTarkibi {
  id               String       @id @default(cuid())
  berishId         String
  tovarId          String?
  nomi             String
  birlik           String?
  miqdor           Decimal      @default(1) @db.Decimal(12, 3)
  holati           NamunaHolati @default(BERILGAN)
  topshirilganVaqt DateTime?
  qabulQilganId    String?
  yangilangan      DateTime     @updatedAt

  berish      NamunaBerish   @relation(fields: [berishId], references: [id], onDelete: Cascade)
  tovar       Tovar?         @relation(fields: [tovarId], references: [id], onDelete: SetNull)
  qabulQilgan Foydalanuvchi? @relation("NamunaQabulQilgan", fields: [qabulQilganId], references: [id], onDelete: SetNull)

  @@index([berishId])
  @@index([holati])
  @@index([yangilangan])
  @@map("namuna_tarkiblari")
}
