# Nusxa oling: cp .env.example .env — va qiymatlarni to'ldiring.
# Haqiqiy .env hech qachon repoga qo'shilmaydi (.gitignore).

# ─── Baza (Neon PostgreSQL) ──────────────────────────────────────────────────
DATABASE_URL="postgresql://foydalanuvchi:parol@host/baza?sslmode=require"

# ─── Kirish (NextAuth v5) ────────────────────────────────────────────────────
# Tasodifiy uzun qator: `openssl rand -base64 32`
AUTH_SECRET=""
# Lokal ish uchun. Vercel'da shart emas (trustHost yoqilgan).
AUTH_URL="http://localhost:3001"

# ─── Onlayn do'kon (biomax-marketplace) bilan aloqa ──────────────────────────
# Marketplace'dagi ERP_HMAC_SECRET bilan AYNAN bir xil bo'lishi shart
# (kamida 32 belgi). Yo'q bo'lsa ERP har so'rovga `kalit_sozlanmagan` qaytaradi.
MP_HMAC_SECRET=""
# Buyurtmalarni boshqarish uchun marketplace manzili
MARKETPLACE_URL="http://localhost:3002"
# Mijozga Telegram xabaridagi havola va ilova QR kodi uchun ommaviy manzil
MARKETPLACE_OMMAVIY_URL="https://www.biomaxmarketplace.store"
# Kirish kodi: keshda yo'q yangi raqamlarga soatiga nechta kod (standart 20)
# MP_KOD_YANGI_RAQAM_SOATIGA=20

# ─── Vercel Cron ─────────────────────────────────────────────────────────────
# /api/cron/* ni himoyalaydi: Vercel "Authorization: Bearer $CRON_SECRET" yuboradi
CRON_SECRET=""

# ─── Kuryer ovoz yozuvlari ombori (S3 bilan mos) ─────────────────────────────
# Tavsiya: Cloudflare R2 (10 GB bepul, yuklab olish bepul). Chelak ochiq
# qilinmaydi — yozuv faqat ruxsatli xodimga 10 daqiqalik imzolangan havola
# bilan beriladi. Bo'sh bo'lsa: lokalda `.ovoz-yozuvlar/` papkasi ishlatiladi,
# productionda yozuv qabul qilinmaydi (bo'laklar kuryer telefonida kutib
# turadi). Sozlagach: Xodimlar → kuryer → "Ish va ovozlar" → "Tekshirish".
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_BUCKET="biomax-ovozlar"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# R2 uchun "auto"; AWS S3'da chelak mintaqasi (masalan eu-central-1)
# S3_REGION="auto"
# Cloudflare hujjatlaridagi nomlar ham qabul qilinadi: R2_ACCOUNT_ID (endpoint
# o'zi tuziladi), R2_BUCKET, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY. Endpoint
# chelak nomi bilan nusxalansa ham (…cloudflarestorage.com/biomax-ovozlar) ishlaydi.

# ─── Faqat rivojlanish ───────────────────────────────────────────────────────
# Lokal ERP jonli Telegram sessiyasiga ulanmaydi (serverdagi sessiya bekor
# bo'lmasin). Haqiqiy yuborishni sinash kerak bo'lsa: true
# ONLAYN_TELEGRAM_DEV=false

# ─── Eski VPS davridan (Vercel'da ishlatilmaydi) ─────────────────────────────
# `npm run bot` uchun Telegram bot tokeni
# TELEGRAM_BOT_TOKEN=""
