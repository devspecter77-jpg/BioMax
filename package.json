{
  "name": "erp-dokon",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "prisma migrate dev",
    "db:seed": "ts-node -P tsconfig.scripts.json prisma/seed.ts",
    "db:studio": "prisma studio",
    "bot": "ts-node -P tsconfig.scripts.json src/bot/index.ts",
    "scheduler": "ts-node -P tsconfig.scripts.json src/bot/scheduler.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run bot\" \"npm run scheduler\"",
    "db:clean": "ts-node -P tsconfig.scripts.json prisma/clean.ts"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@prisma/adapter-pg": "^7.4.1",
    "@prisma/client": "^7.4.1",
    "@radix-ui/react-popover": "^1.1.15",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.22",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.16.0",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.4",
    "grammy": "^1.40.1",
    "html5-qrcode": "^2.3.8",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.575.0",
    "next": "16.3.5",
    "next-auth": "^5.0.0-beta.32",
    "node-cron": "^4.2.1",
    "pg": "^8.19.0",
    "prisma": "^7.4.1",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "telegram": "^2.26.22",
    "xlsx": "^0.18.5"
  },
  "optionalDependencies": {
    "@next/swc-win32-x64-msvc": "16.3.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
